LLM_PROVIDER=lmstudio
LLM_TIMEOUT_SECONDS=640
LLM_MAX_OUTPUT_TOKENS=384
LLM_MAX_TOKENS=384
LLM_ENABLE_THINKING=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=deepseek/deepseek-r1-0528-qwen3-8b
RAG_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_TOP_K=4
RAG_INDEX_PATH=.indai_ma/rag_index
INDAI_API_BASE_URL=http://127.0.0.1:8000
# C1.4: configure trusted identity explicitly; empty values keep analysis closed.
# No user, tenant, access token or membership grants are supplied by default.
INDAI_OIDC_ISSUER=
INDAI_OIDC_AUDIENCE=
INDAI_OIDC_JWKS_URL=
# Admin-owned JSON list: issuer, subject, tenant_id, roles (see ADR-024).
INDAI_MEMBERSHIPS_FILE=
INDAI_API_CONNECT_TIMEOUT_SECONDS=5
INDAI_API_ANALYSIS_TIMEOUT_SECONDS=300
