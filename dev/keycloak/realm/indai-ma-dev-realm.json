{
  "realm": "indai-ma-dev",
  "enabled": true,
  "displayName": "indAI MA local development only",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "verifyEmail": false,
  "rememberMe": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 1800,
  "bruteForceProtected": true,
  "clientScopes": [{"name": "profile", "protocol": "openid-connect", "protocolMappers": [], "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}}],
  "clients": [
    {
      "clientId": "indai-ma-streamlit",
      "name": "Local Streamlit OIDC client",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${INDAI_STREAMLIT_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:8501/oauth2callback"],
      "webOrigins": ["http://localhost:8501"],
      "defaultClientScopes": ["profile"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.header.type.rfc9068": "true",
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "http://localhost:8501/oauth2callback",
        "use.refresh.tokens": "false",
        "client.use.lightweight.access.token.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "protocolMappers": [
        {"name": "API audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false,
         "config": {"included.client.audience": "indai-ma-api", "access.token.claim": "true", "id.token.claim": "false"}},
        {"name": "RFC9068 client_id", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "consentRequired": false,
         "config": {"claim.name": "client_id", "claim.value": "indai-ma-streamlit", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}},
        {"name": "RFC9068 subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "consentRequired": false,
         "config": {"access.token.claim": "true", "introspection.token.claim": "false"}}
      ]
    },
    {
      "clientId": "indai-ma-api",
      "name": "API audience only; no interactive or service-account grant",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {"id": "11111111-1111-4111-8111-000000000001", "username": "analyst-a", "firstName": "Analyst", "lastName": "Alpha", "enabled": true, "requiredActions": [], "credentials": [{"type": "password", "value": "${KC_ANALYST_A_PASSWORD}", "temporary": false}]},
    {"id": "11111111-1111-4111-8111-000000000002", "username": "analyst-b", "firstName": "Analyst", "lastName": "Beta", "enabled": true, "requiredActions": [], "credentials": [{"type": "password", "value": "${KC_ANALYST_B_PASSWORD}", "temporary": false}]},
    {"id": "11111111-1111-4111-8111-000000000003", "username": "viewer-a", "firstName": "Viewer", "lastName": "Alpha", "enabled": true, "requiredActions": [], "credentials": [{"type": "password", "value": "${KC_VIEWER_A_PASSWORD}", "temporary": false}]},
    {"id": "11111111-1111-4111-8111-000000000004", "username": "outsider", "firstName": "Outside", "lastName": "Member", "enabled": true, "requiredActions": [], "credentials": [{"type": "password", "value": "${KC_OUTSIDER_PASSWORD}", "temporary": false}]}
  ]
}
